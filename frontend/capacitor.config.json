{
  "appId": "me.quienva.app",
  "appName": "¿Quién va?",
  "webDir": "build",
  "backgroundColor": "#0A0A0C",
  "loggingBehavior": "none",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0A0A0C",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "backgroundColor": "#0A0A0C"
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0A0A0C",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0A0A0C"
    }
  }
}
