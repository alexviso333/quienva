{
  "rewrites": [
    { "source": "/fiestas/:city/esta-noche", "destination": "https://quienva.onrender.com/api/ciudad/:city/esta-noche" },
    { "source": "/fiestas/:city/este-finde", "destination": "https://quienva.onrender.com/api/ciudad/:city/este-finde" },
    { "source": "/en/parties/:city/tonight", "destination": "https://quienva.onrender.com/api/en/city/:city/tonight" },
    { "source": "/en/parties/:city/this-weekend", "destination": "https://quienva.onrender.com/api/en/city/:city/this-weekend" },
    { "source": "/de/partys/:city/heute", "destination": "https://quienva.onrender.com/api/de/city/:city/heute" },
    { "source": "/de/partys/:city/wochenende", "destination": "https://quienva.onrender.com/api/de/city/:city/wochenende" },
    { "source": "/fiestas/:city", "destination": "https://quienva.onrender.com/api/ciudad/:city" },
    { "source": "/en/parties/:city", "destination": "https://quienva.onrender.com/api/en/city/:city" },
    { "source": "/de/partys/:city", "destination": "https://quienva.onrender.com/api/de/city/:city" },
    { "source": "/fiesta/:id/:slug", "destination": "https://quienva.onrender.com/api/fiesta/:id/:slug" },
    { "source": "/fiesta/:id", "destination": "https://quienva.onrender.com/api/fiesta/:id" },
    { "source": "/en/party/:id/:slug", "destination": "https://quienva.onrender.com/api/en/party/:id/:slug" },
    { "source": "/en/party/:id", "destination": "https://quienva.onrender.com/api/en/party/:id" },
    { "source": "/de/party/:id/:slug", "destination": "https://quienva.onrender.com/api/de/party/:id/:slug" },
    { "source": "/de/party/:id", "destination": "https://quienva.onrender.com/api/de/party/:id" },
    { "source": "/sitemap.xml", "destination": "https://quienva.onrender.com/api/sitemap.xml" },
    { "source": "/sitemap-cities.xml", "destination": "https://quienva.onrender.com/api/sitemap-cities.xml" },
    { "source": "/sitemap-events-:city.xml", "destination": "https://quienva.onrender.com/api/sitemap-events-:city.xml" },
    { "source": "/robots.txt", "destination": "https://quienva.onrender.com/api/robots.txt" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|webp|ico|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
